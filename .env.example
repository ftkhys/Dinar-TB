NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_me
DB_DATABASE=dinar_tb
DB_SSL=false

# Generate a unique secret with: openssl rand -base64 32
AUTH_JWT_SECRET=replace_with_a_long_random_secret

# Browser patient session (secure cookies require HTTPS in production)
WEB_SESSION_TTL_DAYS=7
# Set true in production (HTTPS). Use false only for local HTTP.
WEB_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=https://dinartb.my.id,https://admin.dinartb.my.id

# Web Push / VAPID. Generate with: node scripts/generate-vapid-keys.js
WEB_PUSH_SUBJECT=mailto:admin@dinartb.my.id
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
